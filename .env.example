# Copy this file to .env and adjust it for your machine.
# Environment variables set in the shell take precedence over .env.

# Paths to the ffmpeg and ffprobe executables, used to generate thumbnails.
# If either is unset, the server runs without thumbnails.
FFMPEG_PATH = "C:/ffmpeg/bin/ffmpeg.exe"
FFPROBE_PATH = "C:/ffmpeg/bin/ffprobe.exe"

# JSON file holding the database (counts and tags). Created on the first
# save if it doesn't exist. Default: db.json
DB_FILE = "db.json"

# Folder holding the videos, laid out as <source>/<title>/<video files>
# (.mp4, .m4v, .webm, .mkv or .mov).
# Default: videos
DIRECTORY = "videos"

# Port for `npm start`. Ignored by `npm run dev`, which uses Vite's port.
# Default: 3000
PORT = 3000

# Address `npm start` listens on. The default only accepts connections from
# this machine; 0.0.0.0 accepts them from your network too (set PASSWORD
# then). Ignored by `npm run dev` (use `npm run dev -- --host` there).
# Default: 127.0.0.1
# HOST = 0.0.0.0

# If set, the browser asks for this password (any user name) before showing
# anything. Default: none
# PASSWORD = "change me"

# Extra host names to accept while HOST is a loopback address, separated by
# commas, e.g. the name a reverse proxy on this machine serves the site as.
# Requests for other names are refused. Default: none
# ALLOWED_HOSTS = videos.example.com
