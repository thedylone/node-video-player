# Copy this file to .env and adjust it for your machine.
# Environment variables set in the shell take precedence over .env.

# Paths to the ffmpeg and ffprobe executables, used to generate thumbnails.
# If either is unset, the server runs without thumbnails.
FFMPEG_PATH = "C:/ffmpeg/bin/ffmpeg.exe"
FFPROBE_PATH = "C:/ffmpeg/bin/ffprobe.exe"

# JSON file holding the database (counts and tags). Created on the first
# save if it doesn't exist. Default: db.json
DB_FILE = "db.json"

# Folder holding the videos, laid out as <source>/<title>/<video files>
# (.mp4, .m4v, .webm, .mkv or .mov).
# Default: videos
DIRECTORY = "videos"

# Port for `npm start`. Ignored by `npm run dev`, which uses Vite's port.
# Default: 3000
PORT = 3000
