{
    "name": "video-player",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "^22.22.0 || >=24.15.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:server": "vite build --ssr src/server/main.ts --outDir dist-server",
        "start": "node dist-server/main.js",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "typecheck": "tsc && tsc -p tsconfig.node.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:smoke": "bash scripts/smoke-test.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview"
    },
    "dependencies": {
        "dotenv": "^16.3.1",
        "express": "^5.3.0",
        "fluent-ffmpeg": "^2.1.2",
        "jsonfile": "^6.1.0",
        "nanoid": "^5.0.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/express": "^5.0.6",
        "@types/fluent-ffmpeg": "^2.1.22",
        "@types/jsonfile": "^6.1.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/supertest": "^7.2.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "typescript": "~5.9",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
